{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|privacy\\.html|terms\\.html|googlec386f2144a0acb7b\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
